{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2021",
        "sourceMap": true,
        "outDir": "dist",
        "noImplicitAny": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
    },
    "include": ["src/**/*", "test/tests.tsec.ts"],
    "exclude": [
        "test",
        "./node_modules/",
        "./dist/",
        "src/debug-puppeteer.ts",
        "src/scrappers/ebay-scrapper-puppeteer.ts",
        "src/test-ebay-api.ts",
        "src/test-ebay-scrape.ts"
      ]
}